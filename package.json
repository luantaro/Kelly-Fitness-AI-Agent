    "test:e2e:profile": "playwright test tests/user-profile.spec.ts",
    "test:e2e:admin": "playwright test tests/admin-profile.spec.ts",
    "test:e2e:sync": "playwright test tests/bidirectional-sync.spec.ts",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@stripe/stripe-js": "^7.8.0",
