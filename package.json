    "react-dom": "19.1.0",
    "react-firebase-hooks": "^5.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-jsx": "^5.1.7",
    "zod": "^3.25.76"
