    "@types/dompurify": "^3.0.5",
    "docx": "^9.5.1",
    "dompurify": "^3.2.6",
    "dotenv": "^17.2.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^12.23.12",
    "html2canvas": "^1.4.1",
